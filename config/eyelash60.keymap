#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Qwery {
            bindings = <
&kp ESC           &kp 1         &kp 2             &kp 3      &kp 4      &kp 5              &kp 6          &kp 7              &kp 8                &kp 9                    &kp 0    &kp BSPC &kp BSPC &kp BSPC
&kp TAB           &kp Q         &kp W             &kp E      &kp R      &kp T              &kp Y          &kp U              &kp I                &kp O                    &kp P    &kp BSPC &kp BSPC &kp BSPC
&kp CAPS          &kp A         &kp S             &kp D      &kp F      &kp G              &kp H          &kp J              &kp K                &kp L                    &kp RET &kp BSPC &kp BSPC
&kp LEFT_SHIFT    &kp Z         &kp X             &kp C      &kp V      &kp B              &kp N          &kp M              &kp Q         &kp W             &kp E &kp BSPC
&kp Q         &kp W             &kp E      &kp R      &kp T              &kp Y          &kp U              &kp I  &kp BSPC &kp BSPC
            >;

            label = "Qwery";
        };

        layer_1 {
            bindings = <
&kp ESC           &kp 1         &kp 2             &kp 3      &kp 4      &kp 5              &kp 6          &kp 7              &kp 8                &kp 9                    &kp 0    &kp BSPC &kp BSPC &kp BSPC
&kp TAB           &kp Q         &kp W             &kp E      &kp R      &kp T              &kp Y          &kp U              &kp I                &kp O                    &kp P    &kp BSPC &kp BSPC &kp BSPC
&kp CAPS          &kp A         &kp S             &kp D      &kp F      &kp G              &kp H          &kp J              &kp K                &kp L                    &kp RET &kp BSPC &kp BSPC
&kp LEFT_SHIFT    &kp Z         &kp X             &kp C      &kp V      &kp B              &kp N          &kp M              &kp Q         &kp W             &kp E &kp BSPC
&kp Q         &kp W             &kp E      &kp R      &kp T              &kp Y          &kp U              &kp I  &kp BSPC &kp BSPC
            >;
        };

        layer_2 {
            bindings = <
&kp ESC           &kp 1         &kp 2             &kp 3      &kp 4      &kp 5              &kp 6          &kp 7              &kp 8                &kp 9                    &kp 0    &kp BSPC &kp BSPC &kp BSPC
&kp TAB           &kp Q         &kp W             &kp E      &kp R      &kp T              &kp Y          &kp U              &kp I                &kp O                    &kp P    &kp BSPC &kp BSPC &kp BSPC
&kp CAPS          &kp A         &kp S             &kp D      &kp F      &kp G              &kp H          &kp J              &kp K                &kp L                    &kp RET &kp BSPC &kp BSPC
&kp LEFT_SHIFT    &kp Z         &kp X             &kp C      &kp V      &kp B              &kp N          &kp M              &kp Q         &kp W             &kp E &kp BSPC
&kp Q         &kp W             &kp E      &kp R      &kp T              &kp Y          &kp U              &kp I  &kp BSPC &kp BSPC
            >;
        };
    };
};
